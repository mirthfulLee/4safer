{
  "experiment": "ablation",
  "synthesize": {
    "csv": "misc/trophy_crates.csv",
    "sources_dir": "tmp/paper-experiments/sources",
    "out": "tmp/paper-experiments/runs",
    "backends": [
      "kani"
    ],
    "jobs": 4,
    "timeout": 7200,
    "log_level": "info"
  },
  "configs": [
    {
      "name": "od_sequence_full",
      "max_mutators": 4,
      "max_depth": 0,
      "env": {}
    },
    {
      "name": "od_no_reuse_penalty",
      "max_mutators": 4,
      "max_depth": 0,
      "disable_reuse": true,
      "env": {}
    },
    {
      "name": "od_no_depth_penalty",
      "max_mutators": 4,
      "max_depth": 0,
      "disable_depth": true,
      "env": {}
    },
    {
      "name": "od_no_reuse_no_depth_penalty",
      "max_mutators": 4,
      "max_depth": 0,
      "disable_reuse": true,
      "disable_depth": true,
      "env": {}
    },
    {
      "name": "od_sequence_unlimited",
      "max_mutators": 4,
      "max_depth": 0,
      "disable_sequence_limits": true,
      "env": {}
    }
  ]
}
